<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_slide" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
    <ImageView android:id="@+id/widget_photo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="保存した宝物の切り抜き写真" />
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#563f33" android:textSize="12sp" android:paddingTop="5dp" />
    <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#9a8372" android:textSize="10sp" />
</LinearLayout>
